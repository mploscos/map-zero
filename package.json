{
  "name": "map-zero-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @map-zero/cli",
    "start": "npm run start --workspace @map-zero/cli",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/smoke-viewers.mjs",
    "test:browser:static": "node scripts/smoke-static-cesium.mjs",
    "docs:record": "node scripts/record-readme.mjs",
    "docs:record:bbox": "node scripts/record-bbox.mjs",
    "pack:check": "npm pack --dry-run --workspaces"
  },
  "engines": {
    "node": ">=24.2"
  },
  "devDependencies": {
    "cesium": "1.145.0",
    "ol": "10.10.0",
    "playwright-core": "1.63.0"
  }
}
