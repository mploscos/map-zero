{
  "name": "@map-zero/cli",
  "version": "0.7.0",
  "description": "Portable vector maps from OSM or custom geospatial data, with GeoPackage storage, PMTiles delivery, and static 3D Tiles export.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/mploscos/map-zero#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mploscos/map-zero.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mploscos/map-zero/issues"
  },
  "bin": {
    "map-zero": "src/cli.js"
  },
  "scripts": {
    "dev": "node src/cli.js --help",
    "start": "node src/cli.js"
  },
  "engines": {
    "node": ">=24.2"
  },
  "keywords": [
    "osm",
    "openstreetmap",
    "geopackage",
    "mvt",
    "pmtiles",
    "3d-tiles",
    "offline-maps",
    "vector-tiles",
    "geospatial",
    "gis"
  ],
  "files": [
    "src",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@map-zero/core": "^0.7.0",
    "commander": "14.0.3",
    "earcut": "3.0.2",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "geojson-vt": "4.0.2",
    "js-angusj-clipper": "1.3.1",
    "osm-pbf-parser": "2.3.0",
    "pmtiles": "4.5.0",
    "vt-pbf": "3.1.3",
    "wkx": "0.5.0"
  },
  "exports": {
    "./gpkg": "./src/gpkg.js",
    "./gpkg-read": "./src/gpkg-read.js",
    "./manifest": "./src/manifest.js",
    "./export-pmtiles": "./src/export-pmtiles.js",
    "./*": "./*"
  }
}
